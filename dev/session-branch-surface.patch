+  /** Whether a tool result's assistant tool-call is already on the selected path. */
+  private selectedSurfaceContainsToolCall(event: Extract<SessionEvent, { type: 'tool/result' }>): boolean {
+    const toolCallId = event.data.message.toolCallId
+    return (this.selectedMessageSurface ?? []).some(seq => {
+      const selected = this.log[seq]
+      if (selected?.type !== 'assistant/message') return false
+      return selected.data.message.content.some(block => block.type === 'tool-call' && block.id === toolCallId)
+    })
+  }
